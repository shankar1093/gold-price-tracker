FROM python:3.11

# Install PostgreSQL client, cron, and curl
RUN apt-get update && \
    apt-get install -y postgresql-client cron curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app
COPY requirements.txt .
RUN pip install -r requirements.txt
RUN pip install watchdog  # For auto-reloading
COPY . .

# Create startup script
RUN echo '#!/bin/bash\n\
echo "Creating database migrations..."\n\
python manage.py makemigrations\n\
echo "Applying database migrations..."\n\
python manage.py migrate\n\
echo "Starting development server..."\n\
python manage.py runserver 0.0.0.0:8000 --settings=mjw_services.settings' > /usr/src/app/startup.sh

RUN chmod +x /usr/src/app/startup.sh

EXPOSE 8000
CMD ["/usr/src/app/startup.sh"]