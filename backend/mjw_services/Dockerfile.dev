# syntax=docker.io/docker/dockerfile:1

# Use slim Python image for smaller size and faster pulls
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system dependencies in a single layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    cron \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

# Install Python dependencies with cache mount
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt && \
    pip install watchdog

COPY . .

# Create startup script
RUN echo '#!/bin/bash\n\
echo "Creating database migrations..."\n\
python manage.py makemigrations\n\
echo "Applying database migrations..."\n\
python manage.py migrate\n\
echo "Starting development server..."\n\
python manage.py runserver 0.0.0.0:8000 --settings=mjw_services.settings' > /usr/src/app/startup.sh && \
    chmod +x /usr/src/app/startup.sh

EXPOSE 8000
CMD ["/usr/src/app/startup.sh"]
